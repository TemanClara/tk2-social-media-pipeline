# Salin file ini jadi .env lalu isi nilainya.
# .env TIDAK ikut ter-commit (lihat .gitignore).

# --- X / Twitter ---
X_BEARER_TOKEN=
X_USERNAME=
X_PASSWORD=

# --- Instagram ---
IG_SESSION_ID=
IG_USERNAME=

# --- TikTok ---
TIKTOK_MS_TOKEN=

# --- Pseudonimisasi ---
# String acak panjang. Jangan diubah selama pengumpulan data,
# dan samakan antar anggota tim agar hash konsisten.
PSEUDONYM_SALT=

# --- Pengaturan umum ---
# Jeda antar permintaan dalam detik (sopan terhadap server, lihat C6 Etika)
REQUEST_DELAY_SECONDS=2.0
MAX_RETRIES=4
DATA_DIR=data
