# Salin file ini jadi .env lalu isi nilainya.
# .env TIDAK ikut ter-commit (lihat .gitignore).
# TikTok dan Instagram diakses tanpa login, jadi tidak butuh kredensial.

# --- X / Twitter ---
# Bearer Token dari X Developer Console. Terikat ke akun dan saldo
# pemiliknya, jadi jangan dibagikan.
X_BEARER_TOKEN=
# Batas total post yang dibaca per run (tiap post ditagih). Bawaan 2000.
# Dengan --x-budget rata (bawaan), jatah ini dibagi ke tiap rentang waktu.
X_MAX_POSTS_READ=2000

# --- Pseudonimisasi ---
# String acak panjang, buat dengan:
#   .venv/bin/python -c "import secrets; print(secrets.token_hex(32))"
# Jangan diubah selama pengumpulan data agar hash konsisten. Bagikan hanya
# lewat jalur pribadi, kepada anggota tim yang ikut menjalankan scraping atau
# modul yang meng-hash username.
PSEUDONYM_SALT=

# --- Pengaturan umum ---
# Jeda antar permintaan dalam detik (sopan terhadap server)
REQUEST_DELAY_SECONDS=2.0
# Jumlah percobaan ulang permintaan X yang gagal sementara (429, 5xx)
MAX_RETRIES=4
DATA_DIR=data
