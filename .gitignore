# Kredensial — JANGAN pernah di-commit
.env
*.pem
*.key

# Data berisi konten pengguna. Hanya data/sample yang boleh naik,
# dan isinya wajib sudah teranonimisasi.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

